{
  "manifest_version": 3,
  "name": "Save to Cookbo",
  "version": "1.0",
  "description": "Save the recipe on this page to your Cookbo cookbook in iCloud Drive.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Save to Cookbo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"]
}
